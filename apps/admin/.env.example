# Base URL admin resolves stored image paths against when previewing a
# project (packages/content-data/src/projects.json stores root-relative
# paths like "/projects/foo.png"). Defaults to http://localhost:3000, i.e.
# the web app's own dev server.
# NEXT_PUBLIC_ASSET_BASE_URL=http://localhost:3000

# Which storage backend the CMS repositories (projects, categories,
# tool-badges, uploaded images - see src/shared/storage/) write to.
#
# "filesystem" (default, no need to set it) - writes straight into
# packages/content-data/src/*.json and apps/web/public/projects/uploads/.
# Only works when admin and web share a filesystem, e.g. local dev or a
# single combined deployment.
#
# "r2" - writes to a Cloudflare R2 bucket instead. Required for deploying
# admin as its own Vercel project (a separate deployment has no shared,
# persistent filesystem with web). Requires the R2_* vars below.
# ADMIN_STORAGE_DRIVER=r2

# Required when ADMIN_STORAGE_DRIVER=r2. Cloudflare account id - the R2
# S3-compatible endpoint is https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com.
# R2_ACCOUNT_ID=

# Required when ADMIN_STORAGE_DRIVER=r2. R2 API token credentials
# (Cloudflare dashboard -> R2 -> Manage API tokens).
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Required when ADMIN_STORAGE_DRIVER=r2. Name of the R2 bucket content and
# uploaded images are stored in.
# R2_BUCKET_NAME=

# Required when ADMIN_STORAGE_DRIVER=r2. Public base URL uploaded images
# (and JSON content) are served from - either the bucket's r2.dev public
# URL, or a custom domain/CDN mapped to it. No trailing slash. Give apps/web
# this same value as CONTENT_SOURCE=remote's CONTENT_CDN_URL, so the site
# reads from the same bucket this app writes to.
# R2_PUBLIC_URL_BASE=https://cdn.your-domain.com

# Required - every route except /login is gated behind a signed-in session
# (see src/proxy.ts). Base64 of a JSON array of {"login", "passwordHash"} -
# never store a plaintext password here, only a bcrypt hash of one. Base64,
# not raw JSON, because a bcrypt hash contains "$" characters ("$2b$10$...")
# that Next's own .env loader tries to interpolate as ${OTHER_VAR} references
# and silently strips when they don't resolve - base64 has no "$", so that
# can't happen. Two steps:
#
# 1. Hash each person's password:
#    node -e "console.log(require('bcryptjs').hashSync('their-password', 10))"
# 2. Build the array with both hashes and base64-encode the whole thing:
#    node -e "console.log(Buffer.from(JSON.stringify([{login:'nick',passwordHash:'HASH_1'},{login:'alona',passwordHash:'HASH_2'}])).toString('base64'))"
#
# ADMIN_USERS=

# Required - secret the session cookie (a signed JWT) is signed with. Any
# long random string; generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this invalidates every existing session (forces re-login).
# SESSION_SECRET=