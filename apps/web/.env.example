# Required in production — public base URL of the deployed site.
# Used for OpenGraph/Twitter metadata, canonical links, sitemap.xml and robots.txt.
# For local development the app falls back to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional - set to "remote" in production to read CMS-editable content
# (currently: projects, categories, tool-badges) from the same Cloudflare R2
# bucket the admin app writes to, instead of only the JSON snapshot bundled
# into this build. Leave unset ("local") for development - admin's
# filesystem storage driver writes straight into packages/content-data, and
# the dev server picks it up on its own, no env needed.
# CONTENT_SOURCE=remote

# Optional for a shared-filesystem deployment: directory containing cv.json
# and cv/uploads/. Defaults to packages/content-data/src in this monorepo.
# Match admin's ADMIN_CONTENT_DIR if overriding it. Not used with remote/R2.
# CONTENT_DATA_DIR=/absolute/path/to/content

# Required when CONTENT_SOURCE=remote (and needed either way once admin
# uploads images to R2 - see below). Public base URL of the R2 bucket - same
# value as apps/admin's R2_PUBLIC_URL_BASE. Three things read this one var,
# by design, so R2 can't end up half-enabled:
#   1. shared/api/contentClient.ts fetches `${CONTENT_CDN_URL}/content/<resource>.json`.
#      A resource that doesn't exist there yet (admin has no editor for it)
#      silently falls back to the bundled snapshot instead of erroring.
#   2. next.config.ts adds this origin to images.remotePatterns, so
#      next/image is allowed to load `<CONTENT_CDN_URL>/projects/uploads/...`
#      (WorksCard, ShowcaseModal, SelectedWork, Projects, Hero, Services all
#      render project/tool images this way once admin's storage driver is r2).
#   3. next.config.ts also adds this origin to the CSP's img-src, or the
#      browser blocks those same images regardless of remotePatterns.
# CONTENT_CDN_URL=https://cdn.your-domain.com

# Optional - how long (seconds) a remote-fetched resource is cached before
# Next re-fetches it. Lower = admin saves show up on the site sooner, at the
# cost of more R2 reads. Admin saves also invalidate the matching cache tag
# immediately when WEB_REVALIDATE_URL is configured, so the one-day default
# does not delay normal CMS updates.
# CONTENT_REVALIDATE_SECONDS=86400

# Required for apps/admin to notify this app the instant a project/
# category/tool-badge is saved (POST /api/revalidate - see admin's
# WEB_REVALIDATE_URL). Checked against that request's Authorization: Bearer
# header. Any long random string; generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Give apps/admin this exact same value as its REVALIDATE_SECRET. Without
# this set, /api/revalidate just 500s and content still updates eventually
# via CONTENT_REVALIDATE_SECONDS.
# REVALIDATE_SECRET=

# Optional - base URL of an external CMS Content API, orthogonal to
# CONTENT_SOURCE above. Only relevant if you swap a resource for a fully
# separate headless CMS instead of R2: shared/api/contentClient.ts falls
# back to `${CONTENT_API_URL}/<resource>` for anything not found locally or
# remotely. No trailing slash.
# CONTENT_API_URL=https://your-content-api.com/api

# Optional - full URL (including the /event path) of the analytics-worker
# deployment - see apps/analytics-worker. Without it, shared/analytics/
# analytics.ts's trackEvent() is a silent no-op: no event ever leaves the
# browser, so this is safe to leave unset in development.
# NEXT_PUBLIC_ANALYTICS_ENDPOINT=https://analytics.your-domain.com/event

# Required for the /contact form to actually send an email - without these,
# src/app/api/contact/route.ts returns a 500 and the form shows its error
# toast. Get an API key at https://resend.com (free tier: 3000 emails/month).
# RESEND_API_KEY=re_your_api_key

# Required - inbox the contact form's submissions are sent to.
# CONTACT_EMAIL_TO=you@example.com

# Optional - "from" address the email is sent as. Defaults to Resend's
# shared sandbox sender (onboarding@resend.dev), which works with no setup.
# Switch this to an address on your own domain once that domain is verified
# in Resend (Settings -> Domains - a few DNS records, a couple minutes if
# your DNS is on Cloudflare already).
# CONTACT_EMAIL_FROM=onboarding@resend.dev
