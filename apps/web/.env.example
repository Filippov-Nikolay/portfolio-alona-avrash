# Required in production — public base URL of the deployed site.
# Used for OpenGraph/Twitter metadata, canonical links, sitemap.xml and robots.txt.
# For local development the app falls back to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional - base URL of an external CMS Content API. All entity content
# (hero, socials, projects, services, reviews, stats, ...) already ships as
# local JSON under src/entities/*/model, so this is unused by default. Set
# it only if you swap a resource for a real CMS: shared/api/contentClient.ts
# falls back to `${CONTENT_API_URL}/<resource>` for anything not found
# locally. No trailing slash.
# CONTENT_API_URL=https://your-content-api.com/api