{
    "name": "portfolio-alona-avrash",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@10.33.0",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "pnpm --filter @avrash/web run dev",
        "dev:admin": "pnpm --filter @avrash/admin run dev",
        "build": "pnpm -r --if-present run build",
        "start": "pnpm --filter @avrash/web run start",
        "lint": "pnpm -r --if-present run lint",
        "lint:fix": "pnpm -r --if-present run lint:fix",
        "type-check": "pnpm -r --if-present run type-check",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{js,ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{scss,css}": [
            "prettier --write"
        ]
    },
    "devDependencies": {
        "eslint": "^9",
        "eslint-config-next": "16.2.6",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "prettier": "^3.8.3"
    }
}
